# Existing TaskCore backend
PORT=3000
NODE_ENV=development
DATABASE_URL=
SQLITE_PATH=./data/taskcore.db
ADMIN_USERNAME=replace-with-local-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
BODY_LIMIT=32kb
TRUST_PROXY=false
TASKCORE_TIMEZONE=America/Los_Angeles
PAYMENT_SESSION_SECRET=replace-with-at-least-32-random-characters
BOOKING_HOLD_MINUTES=15
PAYMENT_SESSION_MINUTES=10

# Square Sandbox payment configuration. Browser receives only application/location IDs.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
