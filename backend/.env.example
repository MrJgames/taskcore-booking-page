PORT=3000
NODE_ENV=development

# Leave DATABASE_URL blank to use local SQLite.
DATABASE_URL=
SQLITE_PATH=./data/taskcore.db

# Use a unique username and a long, randomly generated password in production.
ADMIN_USERNAME=jay
ADMIN_PASSWORD=replace-with-a-long-random-password

# Comma-separated browser origins allowed to submit requests.
# Production: https://mrjgames.github.io
# Local development can keep http://localhost:8000 and http://127.0.0.1:8000.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://mrjgames.github.io

# Public submission protection.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
BODY_LIMIT=32kb
# Render terminates HTTPS at its proxy. Use true on Render and false locally.
TRUST_PROXY=false

# Inspection portal links and evidence storage.
# Production must use the deployed HTTPS backend origin and S3-compatible storage.
PUBLIC_BASE_URL=http://localhost:3000
REPORT_TOKEN_DAYS=30
MEDIA_STORAGE_MODE=local
UPLOAD_DIRECTORY=./data/inspection-media
MAX_PHOTO_BYTES=15728640
MAX_VIDEO_BYTES=262144000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional owner SMS alerts through Twilio.
OWNER_MOBILE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional automatic client report email through Resend.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
