PORT=3000
NODE_ENV=development

# Leave DATABASE_URL blank to use local SQLite.
DATABASE_URL=
SQLITE_PATH=./data/taskcore.db

# Use a unique username and a long, randomly generated password in production.
ADMIN_USERNAME=jay
ADMIN_PASSWORD=replace-with-a-long-random-password

# Comma-separated browser origins allowed to submit requests.
CORS_ORIGINS=http://localhost:8000,https://mrjgames.github.io

# Public submission protection.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
BODY_LIMIT=32kb
TRUST_PROXY=false
